{
    "version": 2,
    "builds": [
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": "/src/main.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/src/main.ts"
        }
    ]
}